---
/**
 * Header.astro — Sticky frosted-glass navigation
 */
import { careBySlug, careMenu } from '../data/care';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const beforeCare = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
];

const afterCare = [
  { href: '/#gallery', label: 'Gallery' },
  { href: '/#services', label: 'Services' },
  { href: '/#reviews', label: 'Reviews' },
  { href: '/#contact', label: 'Contact' },
];

const careActive = careMenu.some((group) =>
  group.slugs.some((slug) => currentPath === `/${slug}`),
);
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <a href="/" class="logo">
      <img
        class="logo-wordmark"
        src="/precision-spinal-care-logo.png"
        alt="Precision Spinal Care"
        width="422"
        height="131"
      />
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {beforeCare.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="nav-item">
          <button
            type="button"
            class:list={['nav-link', 'nav-dropdown-btn', { active: careActive }]}
            aria-expanded="false"
            aria-haspopup="true"
            data-dropdown-toggle
          >
            Chiropractic Care
            <svg class="caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="dropdown">
            {careMenu.map((group) => (
              <div class="dropdown-group">
                {group.label && <p class="dropdown-label">{group.label}</p>}
                {group.slugs.map((slug) => (
                  <a
                    href={`/${slug}`}
                    class:list={['dropdown-link', { active: currentPath === `/${slug}` }]}
                  >
                    {careBySlug[slug].menuLabel}
                  </a>
                ))}
              </div>
            ))}
          </div>
        </li>
        {afterCare.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="tel:1-419-873-7223" class="nav-phone btn btn--primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (419) 873-7223
      </a>
    </nav>

    <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 1rem 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header.scrolled {
    padding: 0.6rem 0;
    background: rgba(246, 241, 232, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(70, 52, 32, 0.1);
    box-shadow: 0 4px 24px rgba(70, 48, 24, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-wordmark {
    display: block;
    height: 48px;
    width: auto;
    filter: none;
  }

  /* ── Nav ── */
  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link {
    display: block;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    border: 1px solid rgba(70, 52, 32, 0.16);
    border-radius: var(--radius-sm);
    background: rgba(255, 253, 248, 0.72);
    transition: all 0.3s ease;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--bone-white);
    background: rgba(255, 253, 248, 0.95);
    border-color: rgba(70, 52, 32, 0.32);
  }

  .nav-link.active {
    color: var(--teal-glow);
    border-color: var(--teal-border);
  }

  .nav-item {
    position: relative;
  }

  .nav-dropdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 253, 248, 0.72);
    cursor: pointer;
    font: inherit;
  }

  .caret {
    transition: transform 0.2s ease;
  }

  .nav-item.open .caret,
  .nav-item:hover .caret,
  .nav-item:focus-within .caret {
    transform: rotate(180deg);
  }

  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(640px, 72vw);
    max-height: 70vh;
    overflow: auto;
    columns: 2;
    column-gap: 1rem;
    padding: 0.75rem;
    background: #fffdf8;
    border: 1px solid rgba(70, 52, 32, 0.12);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    z-index: 40;
  }

  .nav-item:hover .dropdown,
  .nav-item:focus-within .dropdown,
  .nav-item.open .dropdown {
    display: block;
  }

  .dropdown-group {
    break-inside: avoid;
  }

  .dropdown-group + .dropdown-group {
    margin-top: 0.65rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(70, 52, 32, 0.08);
  }

  .dropdown-label {
    margin: 0 0 0.35rem;
    padding: 0 0.65rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-glow);
  }

  .dropdown-link {
    display: block;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .dropdown-link:hover,
  .dropdown-link.active {
    color: var(--bone-white);
    background: rgba(246, 241, 232, 0.9);
  }

  .nav-phone {
    margin-left: 1rem;
    padding: 0.65rem 1.25rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  /* ── Mobile Toggle ── */
  .mobile-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: rgba(255, 253, 248, 0.8);
    border: 1px solid rgba(70, 52, 32, 0.14);
    border-radius: var(--radius-sm);
    cursor: pointer;
    z-index: 1001;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 20px;
  }

  .hamburger span {
    display: block;
    height: 2px;
    background: var(--bone-white);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .mobile-toggle {
      display: flex;
    }

    .main-nav {
      position: fixed;
      top: 0;
      right: 0;
      width: min(320px, 85vw);
      height: 100vh;
      background: rgba(246, 241, 232, 0.98);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-left: 1px solid rgba(70, 52, 32, 0.1);
      flex-direction: column;
      align-items: stretch;
      padding: 5rem 1.5rem 2rem;
      gap: 0.5rem;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 999;
    }

    .main-nav.open {
      transform: translateX(0);
    }

    .nav-list {
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav-link {
      font-size: 1.1rem;
      padding: 0.75rem 1rem;
    }

    .nav-dropdown-btn {
      width: 100%;
      justify-content: space-between;
    }

    .dropdown {
      position: static;
      transform: none;
      width: auto;
      max-height: none;
      columns: auto;
      margin: 0.15rem 0 0.35rem;
      padding: 0.25rem 0 0.25rem 0.5rem;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .nav-item:hover .dropdown,
    .nav-item:focus-within .dropdown {
      display: none;
    }

    .nav-item.open .dropdown {
      display: block;
    }

    .main-nav {
      overflow-y: auto;
    }

    .nav-phone {
      margin-left: 0;
      margin-top: 1rem;
      text-align: center;
      justify-content: center;
    }
  }
</style>

<script>
  // Scroll-aware header
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 60);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Mobile menu toggle
  const toggle = document.getElementById('mobile-toggle');
  const nav = document.getElementById('main-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('open', !expanded);
      document.body.style.overflow = expanded ? '' : 'hidden';
    });

    // Close on nav link click
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('open');
        document.body.style.overflow = '';
      });
    });
  }

  document.querySelectorAll('[data-dropdown-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.nav-item');
      if (!item) return;
      const open = item.classList.toggle('open');
      button.setAttribute('aria-expanded', String(open));
    });
  });
</script>
