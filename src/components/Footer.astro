---
/**
 * Footer.astro — Site footer with contact info, nav, and socials
 */
---

<footer class="site-footer">
  <div class="footer-glow"></div>
  <div class="footer-inner container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-col footer-brand">
        <a href="/" class="footer-logo">
          <img
            class="logo-wordmark"
            src="/precision-spinal-care-logo.png"
            alt="Precision Spinal Care"
            width="422"
            height="131"
          />
        </a>
        <p class="footer-tagline">Natural, non-invasive pain relief through structural corrective care.</p>
        <div class="footer-socials">
          <a href="https://www.facebook.com/precisionspinalcareperrysburg" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/precision_spinal_care/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          </a>
          <a href="https://www.youtube.com/@PrecisionSpinalCarePerrysburg" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/#gallery">Gallery</a></li>
          <li><a href="/#services">Services</a></li>
          <li><a href="/#reviews">Reviews</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-contact">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <a href="https://goo.gl/maps/ofBVKerE7vJpHpTq5" target="_blank" rel="noopener noreferrer">
              10005 Fremont Pike<br />Perrysburg, OH 43551
            </a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:1-419-873-7223">(419) 873-7223</a>
          </li>
        </ul>
      </div>

      <!-- Hours -->
      <div class="footer-col">
        <h4 class="footer-heading">Hours</h4>
        <ul class="footer-hours">
          <li><span>Mon</span><span>8am–12pm, 2–5:30pm</span></li>
          <li><span>Tue</span><span>8am–12pm</span></li>
          <li><span>Wed</span><span>3:30–6pm</span></li>
          <li><span>Thu</span><span>8am–12pm, 2–5:30pm</span></li>
          <li><span>Fri</span><span>8am–12pm</span></li>
          <li class="closed"><span>Sat–Sun</span><span>Closed</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Precision Spinal Care. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--deep-navy);
    border-top: 1px solid rgba(70, 52, 32, 0.1);
    padding: var(--space-2xl) 0 var(--space-lg);
    z-index: 10;
  }

  .footer-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--teal-glow), var(--warm-gold), var(--ice-blue), transparent);
    opacity: 0.4;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-md);
    text-decoration: none;
  }

  .footer-logo .logo-wordmark {
    display: block;
    height: 42px;
    width: auto;
    filter: none;
  }

  .footer-tagline {
    color: var(--dim);
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
  }

  .footer-socials {
    display: flex;
    gap: 0.75rem;
  }

  .footer-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(255, 253, 248, 0.7);
    border: 1px solid rgba(70, 52, 32, 0.12);
    color: var(--muted);
    transition: all 0.3s ease;
  }

  .footer-socials a:hover {
    color: var(--teal-glow);
    background: var(--teal-dim);
    border-color: var(--teal-border);
    transform: translateY(-2px);
  }

  /* Columns */
  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--bone-white);
    margin-bottom: var(--space-md);
  }

  .footer-links li {
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--teal-glow);
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .footer-contact svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--teal-glow);
  }

  .footer-contact a {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
    transition: color 0.3s ease;
  }

  .footer-contact a:hover {
    color: var(--teal-glow);
  }

  /* Hours */
  .footer-hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(70, 52, 32, 0.1);
  }

  .footer-hours li span:first-child {
    color: var(--bone-white);
    font-weight: 500;
    min-width: 60px;
  }

  .footer-hours li span:last-child {
    color: var(--muted);
  }

  .footer-hours .closed span:last-child {
    color: var(--dim);
  }

  /* Bottom */
  .footer-bottom {
    border-top: 1px solid rgba(70, 52, 32, 0.1);
    padding-top: var(--space-lg);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--dim);
    font-size: 0.8rem;
    max-width: none;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 580px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
