---
/**
 * Footer.astro — Site footer with contact info, nav, and socials
 */
---

<footer class="site-footer">
  <div class="footer-glow"></div>
  <div class="footer-inner container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-col footer-brand">
        <a href="/" class="footer-logo">
          <span class="logo-mark">PSC</span>
          <span class="logo-text">Precision<br />Spinal Care</span>
        </a>
        <p class="footer-tagline">Natural, non-invasive pain relief through structural corrective care.</p>
        <div class="footer-socials">
          <a href="https://www.facebook.com/precisionspinalcareperrysburg" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://twitter.com/SpinalPrecision" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.youtube.com/@PrecisionSpinalCarePerrysburg" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/#services">Services</a></li>
          <li><a href="/#reviews">Reviews</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-contact">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <a href="https://goo.gl/maps/ofBVKerE7vJpHpTq5" target="_blank" rel="noopener noreferrer">
              10005 Fremont Pike<br />Perrysburg, OH 43551
            </a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:1-419-873-7223">(419) 873-7223</a>
          </li>
        </ul>
      </div>

      <!-- Hours -->
      <div class="footer-col">
        <h4 class="footer-heading">Hours</h4>
        <ul class="footer-hours">
          <li><span>Mon</span><span>8am–12pm, 2–5:30pm</span></li>
          <li><span>Tue</span><span>8am–12pm</span></li>
          <li><span>Wed</span><span>3:30–6pm</span></li>
          <li><span>Thu</span><span>8am–12pm, 2–5:30pm</span></li>
          <li><span>Fri</span><span>8am–12pm</span></li>
          <li class="closed"><span>Sat–Sun</span><span>Closed</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Precision Spinal Care. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--deep-navy);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding: var(--space-2xl) 0 var(--space-lg);
    z-index: 10;
  }

  .footer-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--teal-glow), var(--warm-gold), var(--ice-blue), transparent);
    opacity: 0.4;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-md);
    text-decoration: none;
  }

  .footer-logo .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--teal-glow), #04b890);
    border-radius: 10px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--midnight);
  }

  .footer-logo .logo-text {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--bone-white);
  }

  .footer-tagline {
    color: var(--dim);
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
  }

  .footer-socials {
    display: flex;
    gap: 0.75rem;
  }

  .footer-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--muted);
    transition: all 0.3s ease;
  }

  .footer-socials a:hover {
    color: var(--teal-glow);
    background: var(--teal-dim);
    border-color: var(--teal-border);
    transform: translateY(-2px);
  }

  /* Columns */
  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--bone-white);
    margin-bottom: var(--space-md);
  }

  .footer-links li {
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--teal-glow);
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .footer-contact svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--teal-glow);
  }

  .footer-contact a {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
    transition: color 0.3s ease;
  }

  .footer-contact a:hover {
    color: var(--teal-glow);
  }

  /* Hours */
  .footer-hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .footer-hours li span:first-child {
    color: var(--bone-white);
    font-weight: 500;
    min-width: 60px;
  }

  .footer-hours li span:last-child {
    color: var(--muted);
  }

  .footer-hours .closed span:last-child {
    color: var(--dim);
  }

  /* Bottom */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding-top: var(--space-lg);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--dim);
    font-size: 0.8rem;
    max-width: none;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 580px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
