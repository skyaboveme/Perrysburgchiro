---
/**
 * index.astro — Precision Spinal Care Homepage
 * Sections: Hero → Why Us → Who We Help → Services → Reviews+Booking → About → Hours → Contact
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Precision Spinal Care — Chiropractor in Perrysburg, OH" currentPath="/">

  <!-- ═══════════════════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="hero-content container">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Perrysburg, Ohio
      </div>
      <h1 class="hero-title">
        Precision<br />
        <span class="text-teal">Spinal</span> Care
      </h1>
      <p class="hero-subtitle">
        Natural, non-invasive pain relief through structural corrective chiropractic — backed by 3D imaging and research-driven methods.
      </p>
      <div class="hero-cta">
        <a href="tel:1-419-873-7223" class="btn btn--primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Book Appointment
        </a>
        <a href="#services" class="btn btn--outline">
          Explore Services
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
        </a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-number" data-count="5000">0</span><span class="stat-plus">+</span>
          <span class="stat-label">Patients Treated</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-number" data-count="5">0</span>
          <span class="stat-label">Star Google Rating</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-number" data-count="100">0</span><span class="stat-plus">%</span>
          <span class="stat-label">Drug-Free Approach</span>
        </div>
      </div>
    </div>
    <div class="hero-scroll-indicator">
      <span></span>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       WHY US
       ═══════════════════════════════════════════════════════════════ -->
  <section class="why-us" id="why-us">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label mx-auto" style="justify-content:center;">Why Choose Us</span>
        <h2 class="section-title">A Different Approach to<br /><span class="text-teal">Chiropractic Care</span></h2>
      </div>
      <div class="why-grid cards-stagger">
        <div class="glass card why-card">
          <div class="why-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--teal-glow)" stroke-width="1.5"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          </div>
          <h3>Structural Corrective Care</h3>
          <div class="gold-line"></div>
          <p>Unlike quick-fix adjustments, Dr. Taylor focuses on correcting the root structural issues in your spine using objective analytics and research-backed methods — no guessing, no cracking.</p>
        </div>
        <div class="glass card why-card">
          <div class="why-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--teal-glow)" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h3>CBCT 3D Imaging</h3>
          <div class="gold-line"></div>
          <p>State-of-the-art Cone Beam CT imaging delivers precise 3D visualization of your spine — allowing us to pinpoint exactly where the problem is and measure your progress objectively.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       WHO WE HELP
       ═══════════════════════════════════════════════════════════════ -->
  <section class="who-we-help" id="who-we-help">
    <div class="container">
      <span class="section-label">Specialized Care</span>
      <h2 class="section-title">Who Can We <span class="text-teal">Help?</span></h2>
      <p class="section-subtitle fade-up">Our structural corrective approach has helped patients with a wide range of conditions, from pediatric to adult care.</p>
      <div class="conditions-grid cards-stagger">
        {[
          { icon: '🧒', title: 'Colic', desc: 'Gentle structural care for infant comfort' },
          { icon: '👂', title: 'Ear Infections', desc: 'Addressing the nervous system connection' },
          { icon: '🧠', title: 'ADHD / Focus', desc: 'Supporting neurological development' },
          { icon: '✋', title: 'Sensory Processing', desc: 'Helping the nervous system regulate' },
          { icon: '💫', title: 'Post Concussion', desc: 'Structural recovery support' },
          { icon: '🫁', title: 'Asthma & Allergies', desc: 'Improving respiratory nerve function' },
          { icon: '⚡', title: 'Nervous System', desc: 'Optimizing overall neural health' },
          { icon: '🤰', title: 'Pregnancy', desc: 'Safe, specialized prenatal adjustments' },
          { icon: '🏃', title: 'Sports Injuries', desc: 'Performance recovery & prevention' },
        ].map((item) => (
          <div class="condition-card glass--subtle">
            <span class="condition-icon">{item.icon}</span>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SERVICES
       ═══════════════════════════════════════════════════════════════ -->
  <section class="services" id="services">
    <div class="container">
      <span class="section-label">Our Expertise</span>
      <h2 class="section-title">How Can Chiropractic<br /><span class="text-gold">Help You?</span></h2>
      <p class="section-subtitle fade-up">Many people dismiss chiropractic as being only for back pain — but treatment addresses a wide variety of physical issues.</p>
      <div class="services-grid cards-stagger">
        {[
          { title: 'Migraines & Headaches', desc: 'Structural misalignments in the upper cervical spine are a leading cause of chronic headaches. We correct the root cause.', icon: '🎯' },
          { title: 'Chronic Pain', desc: 'Persistent pain signals often trace back to spinal structural issues. Our corrective approach addresses the source, not the symptom.', icon: '🔥' },
          { title: 'Carpal Tunnel', desc: 'Nerve compression in the spine can contribute to extremity symptoms. We evaluate the full neural pathway.', icon: '🤚' },
          { title: 'Injury Rehab', desc: 'Whether from auto accidents, work injuries, or sports — structural corrective care accelerates healing and prevents re-injury.', icon: '🔧' },
          { title: 'Sciatica', desc: 'Radiating leg pain from compressed nerve roots responds exceptionally well to precise structural correction.', icon: '⚡' },
          { title: 'Wellness Care', desc: 'Proactive spinal maintenance prevents problems before they start. Keep your nervous system functioning at its peak.', icon: '💎' },
        ].map((svc) => (
          <div class="service-card card">
            <span class="service-icon">{svc.icon}</span>
            <h3>{svc.title}</h3>
            <div class="gold-line"></div>
            <p>{svc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       REVIEWS + BOOKING
       ═══════════════════════════════════════════════════════════════ -->
  <section class="reviews-booking" id="reviews">
    <div class="container">
      <div class="reviews-booking-grid">
        <!-- Reviews Column -->
        <div class="reviews-col">
          <span class="section-label">Patient Reviews</span>
          <h2 class="section-title">What Our Patients <span class="text-gold">Say</span></h2>
          <div class="testimonials-stack">
            <div class="testimonial-card glass">
              <div class="stars">★★★★★</div>
              <blockquote>"This is the premier chiropractic experience in the area. State-of-the-art equipment, caring staff, obvious expertise, inviting space. If you're wanting true 'care' and not just a quick fix — this is the place. Recommend 100%!"</blockquote>
              <div class="testimonial-author">
                <div class="author-avatar">JJ</div>
                <div>
                  <strong>Jarin Jaffee</strong>
                  <span>Google Review</span>
                </div>
              </div>
            </div>
            <div class="testimonial-card glass">
              <div class="stars">★★★★★</div>
              <blockquote>"Dr. Taylor's practice is like no other. His approach is totally different from the chiropractors I have seen in the past. I feel I am improving greatly. He has shown me my progress. He cares, he is kind and patient."</blockquote>
              <div class="testimonial-author">
                <div class="author-avatar">KH</div>
                <div>
                  <strong>Kim Hill</strong>
                  <span>Google Review</span>
                </div>
              </div>
            </div>
            <div class="testimonial-card glass">
              <div class="stars">★★★★★</div>
              <blockquote>"Extremely friendly and knowledgeable. They don't just guess at what might be wrong but use the most up-to-date technology to pinpoint exactly where the problem areas are and then take measures to fix it."</blockquote>
              <div class="testimonial-author">
                <div class="author-avatar">WB</div>
                <div>
                  <strong>Wes Baiz</strong>
                  <span>Google Review</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Booking Column -->
        <div class="booking-col" id="contact">
          <div class="booking-card glass--teal">
            <h3>Request an <span class="text-teal">Appointment</span></h3>
            <p>Fill in your details and we'll reach out to schedule your visit.</p>
            <form class="booking-form" id="booking-form" action="https://formsubmit.co/info@chiropractorperrysburg.com" method="POST">
              <input type="hidden" name="_subject" value="New Appointment Request from Website">
              <input type="hidden" name="_template" value="table">
              <input type="hidden" name="_captcha" value="false">
              <div class="form-group">
                <label for="booking-name">Name <span class="required">*</span></label>
                <input type="text" id="booking-name" name="name" required placeholder="Your full name" autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="booking-phone">Phone <span class="required">*</span></label>
                <input type="tel" id="booking-phone" name="phone" required placeholder="(419) 000-0000" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label for="booking-email">Email</label>
                <input type="email" id="booking-email" name="email" placeholder="your@email.com" autocomplete="email" />
              </div>
              <div class="form-group">
                <label for="booking-message">Message</label>
                <textarea id="booking-message" name="message" rows="3" placeholder="Tell us about your concerns..."></textarea>
              </div>
              <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center;">
                Request Appointment
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       ABOUT
       ═══════════════════════════════════════════════════════════════ -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-image-wrap fade-up">
          <div class="about-image-frame">
            <img
              src="https://chiropractorperrysburg.com/wp-content/uploads/2026/03/IMG_9167.jpg"
              alt="Dr. Taylor Mainous D.C. — Chiropractor at Precision Spinal Care"
              class="about-image"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
        </div>
        <div class="about-content">
          <span class="section-label">Meet Your Doctor</span>
          <h2 class="section-title">About <span class="text-teal">Precision Spinal Care</span></h2>
          <div class="gold-line"></div>
          <p class="fade-up">Many people dismiss chiropractic as being something only for back pain, but chiropractic treatment can be used to treat a wide variety of physical issues, such as migraines and headaches, chronic pain, carpal tunnel, pain due to injury or muscle strain, and much more.</p>
          <p class="fade-up">At Precision Spinal Care our chiropractic team is ready to meet with you to discuss your needs. We will help to design a program that is right for you.</p>
          <p class="fade-up"><strong class="text-white">Dr. Taylor is focused on delivering Structural Corrective care, utilizing objective analytics and research-backed methods.</strong></p>
          <a href="/about" class="btn btn--outline fade-up" style="margin-top:1rem;">
            Learn More
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       OFFICE HOURS
       ═══════════════════════════════════════════════════════════════ -->
  <section class="hours-section" id="hours">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label mx-auto" style="justify-content:center;">Visit Us</span>
        <h2 class="section-title">Office <span class="text-teal">Hours</span></h2>
      </div>
      <div class="hours-grid">
        {[
          { day: 'Monday', hours: '8:00am – 12:00pm\n2:00pm – 5:30pm', open: true },
          { day: 'Tuesday', hours: '8:00am – 12:00pm', open: true },
          { day: 'Wednesday', hours: '3:30pm – 6:00pm', open: true },
          { day: 'Thursday', hours: '8:00am – 12:00pm\n2:00pm – 5:30pm', open: true },
          { day: 'Friday', hours: '8:00am – 12:00pm', open: true },
          { day: 'Sat & Sun', hours: 'Closed', open: false },
        ].map((d) => (
          <div class:list={['hours-card', 'glass--subtle', { 'hours-closed': !d.open }]}>
            <div class="hours-day">{d.day}</div>
            <div class="hours-time">{d.hours.split('\n').map((line: string, i: number) => (
              <span>{line}{i === 0 && d.hours.includes('\n') ? <br /> : null}</span>
            ))}</div>
            {d.open && <div class="hours-dot"></div>}
          </div>
        ))}
      </div>
      <div class="hours-cta text-center fade-up" style="margin-top: var(--space-xl);">
        <a href="https://goo.gl/maps/ofBVKerE7vJpHpTq5" target="_blank" rel="noopener noreferrer" class="btn btn--outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Get Directions — 10005 Fremont Pike
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ═════════════════════════════════════════════════════════════════
     HERO
     ═════════════════════════════════════════════════════════════════ */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-top: 6rem;
  }

  .hero-content {
    text-align: center;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-lg);
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    background: var(--teal-glow);
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(6, 214, 160, 0.4); }
    50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(6, 214, 160, 0); }
  }

  .hero-title {
    margin-bottom: var(--space-md);
    line-height: 1.05;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--muted);
    max-width: 50ch;
    margin: 0 auto var(--space-lg);
    line-height: 1.7;
  }

  .hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-2xl);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero-stat {
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--bone-white);
    display: inline;
  }

  .stat-plus {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 700;
    color: var(--teal-glow);
  }

  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--dim);
    margin-top: 0.25rem;
    letter-spacing: 0.03em;
  }

  .hero-stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .hero-scroll-indicator span {
    display: block;
    width: 24px;
    height: 38px;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    position: relative;
  }

  .hero-scroll-indicator span::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    background: var(--teal-glow);
    border-radius: 4px;
    animation: scroll-bob 2s ease-in-out infinite;
  }

  @keyframes scroll-bob {
    0%, 100% { top: 6px; opacity: 1; }
    50% { top: 18px; opacity: 0.3; }
  }

  /* ═════════════════════════════════════════════════════════════════
     WHY US
     ═════════════════════════════════════════════════════════════════ */
  .why-us {
    background: rgba(17, 24, 39, 0.4);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .why-card {
    padding: var(--space-xl);
  }

  .why-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--teal-dim);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
  }

  .why-card h3 {
    font-size: 1.3rem;
  }

  .why-card p {
    font-size: 0.95rem;
  }

  /* ═════════════════════════════════════════════════════════════════
     WHO WE HELP
     ═════════════════════════════════════════════════════════════════ */
  .conditions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .condition-card {
    padding: var(--space-lg);
    text-align: center;
    transition: all var(--duration-normal) var(--ease-out-expo);
    border-radius: var(--radius-lg);
  }

  .condition-card:hover {
    background: rgba(6, 214, 160, 0.06);
    border-color: var(--teal-border);
    transform: translateY(-4px);
  }

  .condition-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .condition-card h4 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .condition-card p {
    font-size: 0.8rem;
    color: var(--dim);
    max-width: none;
  }

  /* ═════════════════════════════════════════════════════════════════
     SERVICES
     ═════════════════════════════════════════════════════════════════ */
  .services {
    background: rgba(17, 24, 39, 0.3);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .service-card {
    padding: var(--space-lg);
  }

  .service-icon {
    font-size: 1.8rem;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .service-card h3 {
    font-size: 1.15rem;
  }

  .service-card p {
    font-size: 0.9rem;
  }

  /* ═════════════════════════════════════════════════════════════════
     REVIEWS + BOOKING
     ═════════════════════════════════════════════════════════════════ */
  .reviews-booking-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .testimonials-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .testimonial-card {
    padding: var(--space-lg);
  }

  .stars {
    color: var(--warm-gold);
    font-size: 1.1rem;
    letter-spacing: 2px;
    margin-bottom: var(--space-sm);
  }

  .testimonial-card blockquote {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.7;
    font-style: italic;
    margin-bottom: var(--space-md);
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--teal-glow), var(--ice-blue));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--midnight);
  }

  .testimonial-author strong {
    display: block;
    font-size: 0.9rem;
    color: var(--bone-white);
  }

  .testimonial-author span {
    font-size: 0.75rem;
    color: var(--dim);
  }

  /* Booking Form */
  .booking-card {
    padding: var(--space-xl);
